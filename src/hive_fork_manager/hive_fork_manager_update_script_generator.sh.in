#! /bin/bash

set -euo pipefail 
SCRIPTPATH="$(cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P)"

log_exec_params() {
  echo
  echo -n "$0 parameters: "
  for arg in "$@"; do echo -n "$arg "; done
  echo
}

log_exec_params "$@"


print_help () {
    echo "Usage: $0 [OPTION[=VALUE]]..."
    echo
    echo "Creates a patch script that allows to upgrade existing database holding HAF data to a new version without dropping it."
    echo "OPTIONS:"
    echo "  --host=VALUE         Allows to specify a PostgreSQL host location (defaults to /var/run/postgresql)"
    echo "  --port=NUMBER        Allows to specify a PostgreSQL operating port (defaults to 5432)"
    echo "  --haf-db-name=NAME   Allows to specify a name of database to store a HAF data"
    echo "  --haf-admin-account=NAME  Allows to specify a name of database admin role having permission to create the database"
    echo "                       and install an exension inside."
    echo "                       Role MUST be earlier created on pointed Postgres instance !!!"
    echo "                       If omitted, defaults to haf_admin role."
    echo
    echo "  --help               Display this help screen and exit"
    echo
}

psql_do() {
     psql -w "${POSTGRES_ACCESS[@]}" -v ON_ERROR_STOP=on -U "$DB_ADMIN" "$@"
}

# The update session: one connection to $DB_NAME that runs every statement of the update once it is open.
# It is opened before the database stops accepting connections (see fence_connections), because then no
# new session is admitted, a superuser's included.
UPDATE_SESSION_PID=""
UPDATE_SESSION_DIR=""
UPDATE_SESSION_IN=""
UPDATE_SESSION_OUT=""
UPDATE_SESSION_END="-- end of hive_fork_manager update statement $$ --"
CONNECTIONS_FENCED=0

# Runs SQL against $DB_NAME and prints its rows unaligned and without headers: through the update session
# once it is open, otherwise in a connection of its own.
db_sql() {
  if [ -z "$UPDATE_SESSION_PID" ]; then
    psql_do -d "$DB_NAME" -q -t -A -c "$1"
    return
  fi
  # the extra ';' ends a statement that lacks one, so it runs before the \echo that marks its end
  printf '%s\n;\n\\echo %s\n' "$1" "$UPDATE_SESSION_END" >&"$UPDATE_SESSION_IN"
  local line
  while IFS= read -r line <&"$UPDATE_SESSION_OUT"; do
    if [ "$line" = "$UPDATE_SESSION_END" ]; then
      return 0
    fi
    printf '%s\n' "$line"
  done
  echo "ERROR: the update session ended on an error, the update is rolled back" >&2
  return 1
}

open_update_session() {
  UPDATE_SESSION_DIR=$(mktemp -d)
  mkfifo "$UPDATE_SESSION_DIR/in" "$UPDATE_SESSION_DIR/out"
  psql_do -d "$DB_NAME" -q -t -A < "$UPDATE_SESSION_DIR/in" > "$UPDATE_SESSION_DIR/out" &
  UPDATE_SESSION_PID=$!
  exec {UPDATE_SESSION_IN}>"$UPDATE_SESSION_DIR/in" {UPDATE_SESSION_OUT}<"$UPDATE_SESSION_DIR/out"
}

# Closing the session's input ends it; a transaction it has not committed is rolled back.
close_update_session() {
  [ -n "$UPDATE_SESSION_PID" ] || return 0
  exec {UPDATE_SESSION_IN}>&- {UPDATE_SESSION_OUT}<&-
  wait "$UPDATE_SESSION_PID" || true
  UPDATE_SESSION_PID=""
  rm -rf "$UPDATE_SESSION_DIR"
}

# Stops $DB_NAME from accepting connections and ends every other client session in it, so no client
# (an app, PostgREST, pgbouncer reconnecting while the update runs) can take locks the update conflicts with.
fence_connections() {
  local session_backend_pid
  session_backend_pid=$(db_sql "SELECT pg_backend_pid()")
  echo
  echo "Closing database $DB_NAME to other sessions for the duration of the update..."
  CONNECTIONS_FENCED=1
  psql_do -d postgres -q -c "ALTER DATABASE \"$DB_NAME\" ALLOW_CONNECTIONS false"
  psql_do -d postgres -q -c "
    DO \$\$
    DECLARE
      __deadline TIMESTAMPTZ := clock_timestamp() + INTERVAL '60 seconds';
      __remaining INT;
    BEGIN
      LOOP
        PERFORM pg_stat_clear_snapshot();
        SELECT count(pg_terminate_backend(pid)) INTO __remaining
        FROM pg_stat_activity
        WHERE datname = '$DB_NAME' AND backend_type = 'client backend' AND pid <> $session_backend_pid;
        EXIT WHEN __remaining = 0;
        IF clock_timestamp() > __deadline THEN
          RAISE EXCEPTION 'Sessions connected to $DB_NAME did not end within 60 seconds';
        END IF;
        PERFORM pg_sleep(0.1);
      END LOOP;
    END \$\$;"
}

reopen_connections() {
  echo "Opening database $DB_NAME to connections..."
  psql_do -d postgres -q -c "ALTER DATABASE \"$DB_NAME\" ALLOW_CONNECTIONS true"
}

# A generator killed while the database was closed (see fence_connections) leaves it closed; no update was committed then.
reopen_connections_left_closed() {
  local allows_connections
  allows_connections=$(psql_do -d postgres -t -A -c "SELECT datallowconn FROM pg_database WHERE datname = '$DB_NAME'")
  if [ "$allows_connections" = "f" ]; then
    echo "Database $DB_NAME does not accept connections, as an interrupted update leaves it"
    reopen_connections
  fi
}

finish() {
  local exit_code=$?
  close_update_session
  if [ "$CONNECTIONS_FENCED" = 1 ]; then
    reopen_connections || { echo "ERROR: could not reopen database $DB_NAME to connections"; exit_code=5; }
  fi
  exit "$exit_code"
}

DB_NAME="haf_block_log"
DB_ADMIN="haf_admin"
POSTGRES_HOST="/var/run/postgresql"
POSTGRES_PORT=5432


while [ $# -gt 0 ]; do
  case "$1" in
    --host=*)
        POSTGRES_HOST="${1#*=}"
        ;;
    --port=*)
        POSTGRES_PORT="${1#*=}"
        ;;
    --haf-db-name=*)
        DB_NAME="${1#*=}"
        ;;
    --haf-admin-account=*)
        DB_ADMIN="${1#*=}"
        ;;
    --help)
        print_help
        exit 0
        ;;
    -*)
        echo "ERROR: '$1' is not a valid option"
        echo
        print_help
        exit 1
        ;;
    *)
        echo "ERROR: '$1' is not a valid argument"
        echo
        print_help
        exit 2
        ;;
    esac
    shift
done

POSTGRES_ACCESS=("--host=$POSTGRES_HOST" "--port=$POSTGRES_PORT")
COMMIT_PREV_ID=''
COMMIT_NEW_ID='@HAF_GIT_REVISION_SHA@'
POSTGRES_EXTENSION_DIR='@POSTGRES_SHAREDIR@/extension'
DB_NAME_AFTER_UPDATE="upd_${DB_NAME}" # truncate before postgres will do this
DB_NAME_AFTER_UPDATE="${DB_NAME_AFTER_UPDATE:0:63}"
save_table_schema() {
  db_sql "SELECT table_name, table_columns FROM hive_update.calculate_schema_hash()" > before_update_columns.txt
  db_sql "SELECT table_name, table_constraints FROM hive_update.calculate_schema_hash()" > before_update_constraints.txt
  db_sql "SELECT table_name, table_indexes FROM hive_update.calculate_schema_hash()" > before_update_indexes.txt
  db_sql "SELECT provider, hash FROM hive_update.calculate_state_provider_hashes(enum_range(NULL::hafd.state_providers))" > before_update_providers.txt

  psql_do -d "$DB_NAME_AFTER_UPDATE" -o after_update_columns.txt -q -t -A -c "SELECT table_name, table_columns FROM hive_update.calculate_schema_hash()"
  psql_do -d "$DB_NAME_AFTER_UPDATE" -o after_update_constraings.txt -q -t -A -c "SELECT table_name, table_constraints FROM hive_update.calculate_schema_hash()"
  psql_do -d "$DB_NAME_AFTER_UPDATE" -o after_update_indexes.txt -q -t -A -c "SELECT table_name, table_indexes FROM hive_update.calculate_schema_hash()"
  psql_do -d "$DB_NAME_AFTER_UPDATE" -o after_update_providers.txt -q -t -A -c "SELECT provider, hash FROM hive_update.calculate_state_provider_hashes(enum_range(NULL::hafd.state_providers))"
}

verify_table_schema() {
  echo "Attempting to verify if existing table schema is correct..."
  psql_do -a -d postgres -c "CREATE DATABASE $DB_NAME_AFTER_UPDATE WITH OWNER $DB_ADMIN;"
  psql_do -a -d "$DB_NAME_AFTER_UPDATE" -c 'CREATE EXTENSION hive_fork_manager CASCADE;'
  psql_do -d "$DB_NAME_AFTER_UPDATE" -q -t -A -f "$SCRIPTPATH/update.sql"

  STATE_PROVIDERS=$(db_sql "SELECT hive_update.get_used_state_providers()")
  BEFORE_UPDATE=$(db_sql "SELECT hive_update.create_database_hash('${STATE_PROVIDERS}'::hafd.state_providers[])")
  AFTER_UPDATE=$(psql_do -d "$DB_NAME_AFTER_UPDATE" -t -A -c "SELECT hive_update.create_database_hash('${STATE_PROVIDERS}'::hafd.state_providers[])")
  if [ "$BEFORE_UPDATE" = "$AFTER_UPDATE" ]; then
    echo "The table schema is correct, verification completed."
    echo "Dropping temporary database"
    psql_do -a -d postgres -c "DROP DATABASE IF EXISTS $DB_NAME_AFTER_UPDATE;"
  else
    save_table_schema
    echo "Table schema is inconsistent"
    echo "COLUMNS"
    diff --suppress-common-lines before_update_columns.txt after_update_columns.txt || true
    echo "PROVIDERS"
    diff --suppress-common-lines before_update_providers.txt after_update_providers.txt || true
    echo "Dropping temporary database"
    psql_do -a -d postgres -c "DROP DATABASE IF EXISTS $DB_NAME_AFTER_UPDATE;"
    find . -type f -name '*.txt' > /dev/null 2>&1
    exit 1
  fi
}

get_deployed_version() {
  echo "Attempting to find version of already deployed hive_fork_manager extension..."

  COMMIT_PREV_ID=$(psql_do -d "$DB_NAME" -t -A -c "SELECT extversion FROM pg_extension WHERE extname = 'hive_fork_manager'")

  echo "Already deployed hive_fork_manager has a version: $COMMIT_PREV_ID"
}

check_commit_difference() {
  # Check if the commit IDs are the same
  if [ "$COMMIT_PREV_ID" = "$COMMIT_NEW_ID" ]; then
    echo "No changes detected between commits. Skipping update file generation."
    exit 0
  fi
}

generate_final_update_script() {
  echo
  echo "Attempting to generate update file..."
  pushd "${POSTGRES_EXTENSION_DIR}"

  # Postgres extension update rules require to be done only in incremental way by pointing a script hive_fork_manager--<from>--<to>.sql
  ln -svf "${POSTGRES_EXTENSION_DIR}/hive_fork_manager_update--$COMMIT_NEW_ID.sql" "hive_fork_manager--$COMMIT_PREV_ID--$COMMIT_NEW_ID.sql"

  popd
  echo "Update file was created correctly"
}

# Saving, ALTER EXTENSION, restoring and the C function check run in one transaction: when any of them
# fails, the database stays on the deployed version with every app object it had.
update_extension() {
  echo
  echo "Attempting to update your database..."
  db_sql "BEGIN"

  echo
  echo "Saving views and routines that depend on the hive schema..."
  db_sql "SELECT hive_update.save_hive_dependents()"

  db_sql "ALTER EXTENSION hive_fork_manager UPDATE TO '$COMMIT_NEW_ID'"
  db_sql "SELECT hive.state_providers_update_runtime()"

  echo
  echo "Restoring saved views and routines..."
  db_sql "SELECT hive_update.restore_hive_dependents()"

  check_functions_were_updated

  db_sql "COMMIT"
  echo "The database was updated to $COMMIT_NEW_ID"
}

check_tables_dont_reference_haf_types() {
  echo
  echo "Checking that none table references HAF type..."
  query="
    SELECT col.table_schema,col.table_name,col.column_name,col.udt_schema,col.udt_name
      FROM information_schema.columns AS col
      JOIN pg_class as cls ON cls.relname = col.table_name
      WHERE
        cls.relkind = 'r' AND
        col.udt_schema='hive' AND
        col.table_schema<>'hive'"
  db_sql "$query" | \
    awk -F'|' '{print($1"."$2, "contains column", $3, "of type", $4"."$5, "which would be dropped on upgrade")} END{exit NR > 0 ? 4 : 0}'
}

check_tables_dont_reference_haf_domains() {
  echo
  echo "Checking that none table references HAF domain..."

  query="
    SELECT col.table_schema,col.table_name,col.column_name,col.domain_schema,col.domain_name
      FROM information_schema.columns AS col
      JOIN pg_class as cls ON cls.relname = col.table_name
      WHERE
        cls.relkind = 'r' AND
        col.domain_schema='hive' AND
        col.table_schema<>'hive'"
  db_sql "$query" | \
    awk -F'|' '{print($1"."$2, "contains column", $3, "of type", $4"."$5, "which would be dropped on upgrade")} END{exit NR > 0 ? 4 : 0}'
}

# hive_account_operations_uq1 gained INCLUDE (op_type_id). The unique key is unchanged, so no replay is
# needed: the new index is built concurrently next to the old one and swapped in under the same constraint
# name. On mainnet the index takes about 266 GB and about 12.5 minutes to build with hived stopped (longer
# while hived syncs). When the constraint is dropped for a massive sync, only the saved restore command is
# updated, so hive.restore_indexes recreates the new definition.
migrate_account_operations_uq1() {
  echo
  echo "Checking definition of hafd.hive_account_operations_uq1..."

  local uq1_definition='UNIQUE (account_id, account_op_seq_no) INCLUDE (op_type_id)'
  local uq1_state
  uq1_state=$(db_sql "
    SELECT CASE
             WHEN c.oid IS NULL THEN 'absent'
             WHEN pg_get_constraintdef(c.oid) = '${uq1_definition}' THEN 'current'
             ELSE 'outdated'
           END
    FROM (SELECT 1) AS one
    LEFT JOIN pg_constraint c ON c.conrelid = 'hafd.account_operations'::regclass AND c.conname = 'hive_account_operations_uq1'")

  if [ "$uq1_state" = "outdated" ]; then
    echo "Rebuilding hafd.hive_account_operations_uq1 as ${uq1_definition}, this takes a while..."
    # An interrupted earlier run leaves hive_account_operations_uq1_new behind: invalid when the
    # build itself was interrupted (drop and rebuild it), valid when the swap below failed (reuse it).
    local uq1_new_state
    uq1_new_state=$(db_sql "
      SELECT COALESCE(
        (SELECT CASE WHEN i.indisvalid THEN 'valid' ELSE 'invalid' END
         FROM pg_index i
         JOIN pg_class c ON c.oid = i.indexrelid
         JOIN pg_namespace n ON n.oid = c.relnamespace
         WHERE n.nspname = 'hafd' AND c.relname = 'hive_account_operations_uq1_new'),
        'absent')")
    if [ "$uq1_new_state" = "invalid" ]; then
      db_sql "DROP INDEX CONCURRENTLY hafd.hive_account_operations_uq1_new"
    fi
    if [ "$uq1_new_state" = "valid" ]; then
      echo "Reusing the valid hafd.hive_account_operations_uq1_new left by an earlier run"
    else
      db_sql "CREATE UNIQUE INDEX CONCURRENTLY hive_account_operations_uq1_new ON hafd.account_operations (account_id, account_op_seq_no) INCLUDE (op_type_id)"
    fi
    # This runs before ALTER EXTENSION UPDATE, so the ALTER TABLE event trigger still calls C
    # functions of the deployed version's libhfm, which the new image does not ship. The trigger
    # is disabled for the swap; the DISABLE rolls back with the swap if the block fails.
    db_sql "
    DO \$\$
    DECLARE
      __clustered BOOLEAN;
    BEGIN
      SELECT indisclustered INTO __clustered FROM pg_index WHERE indexrelid = 'hafd.hive_account_operations_uq1'::regclass;
      ALTER EVENT TRIGGER hive_block_edit_registered_tables_trigger DISABLE;
      ALTER TABLE hafd.account_operations DROP CONSTRAINT hive_account_operations_uq1;
      ALTER TABLE hafd.account_operations ADD CONSTRAINT hive_account_operations_uq1 UNIQUE USING INDEX hive_account_operations_uq1_new;
      IF __clustered THEN
        ALTER TABLE hafd.account_operations CLUSTER ON hive_account_operations_uq1;
      END IF;
      ALTER EVENT TRIGGER hive_block_edit_registered_tables_trigger ENABLE;
    END \$\$;
    "
  fi

  db_sql "
    UPDATE hafd.indexes_constraints
    SET command = 'ALTER TABLE hafd.account_operations ADD CONSTRAINT hive_account_operations_uq1 ${uq1_definition}'
    WHERE table_name = 'hafd.account_operations' AND index_constraint_name = 'hive_account_operations_uq1'"
  echo "hafd.hive_account_operations_uq1 was ${uq1_state}, it is now (or will be restored as) ${uq1_definition}"
}

check_functions_were_updated() {
  echo
  echo "Checking that all C functions were properly updated..."

  query="
  SELECT p.proname,p.prosrc,p.probin
    FROM pg_catalog.pg_proc AS p
    JOIN pg_catalog.pg_namespace AS n ON p.pronamespace=n.oid
    JOIN pg_catalog.pg_language AS l ON p.prolang=l.oid
    WHERE (n.nspname='hive' OR n.nspname='hafd' ) AND l.lanname='c' AND p.probin NOT LIKE '%-$COMMIT_NEW_ID.so'"
  db_sql "$query" | \
    awk -v "HASH=$COMMIT_NEW_ID" -F'|' '{print("Function", $1, "references", $2, "in", $3 ", but", HASH, "was expected")} END{exit NR > 0 ? 3 : 0}'
  echo "End of Checking that all C functions were properly updated..."
}

trap finish EXIT
trap 'echo "ERROR: lost the update session"; exit 1' PIPE

reopen_connections_left_closed

# inject newer version of hash computation
psql_do -d "$DB_NAME" -q -t -A -f "$SCRIPTPATH/update.sql"

get_deployed_version

if [ "$COMMIT_PREV_ID" != "$COMMIT_NEW_ID" ]; then
  open_update_session
  fence_connections
fi

# Schema migrations: add columns that exist in new extension but not in old DB.
# These must run BEFORE verify_table_schema so the schema hashes match.
db_sql "
DO \$\$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'hafd' AND table_name = 'hive_state' AND column_name = 'lite_mode'
    ) THEN
        ALTER TABLE hafd.hive_state ADD COLUMN lite_mode boolean NOT NULL DEFAULT FALSE;
    END IF;

    -- Pending requests keep their meaning: they become 'full' requests.
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'hafd' AND table_name = 'vacuum_requests' AND column_name = 'kind'
    ) THEN
        ALTER TABLE hafd.vacuum_requests ADD COLUMN kind text NOT NULL DEFAULT 'full';
        ALTER TABLE hafd.vacuum_requests
            ADD CONSTRAINT vacuum_requests_kind_check CHECK ( kind IN ('full', 'vacuum', 'analyze', 'freeze') );
        ALTER TABLE hafd.vacuum_requests DROP CONSTRAINT pk_hive_vacuum_requests;
        ALTER TABLE hafd.vacuum_requests ADD CONSTRAINT pk_hive_vacuum_requests UNIQUE( schema_name, table_name, kind );
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'hafd' AND table_name = 'vacuum_requests' AND column_name = 'skip_count'
    ) THEN
        ALTER TABLE hafd.vacuum_requests ADD COLUMN skip_count integer NOT NULL DEFAULT 0;
        ALTER TABLE hafd.vacuum_requests ADD COLUMN first_skip_time timestamp;
    END IF;

    -- Existing rows stay unclassified (NULL); the next massive sync classifies them.
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'hafd' AND table_name = 'indexes_constraints' AND column_name = 'massive_sync_class'
    ) THEN
        ALTER TABLE hafd.indexes_constraints ADD COLUMN massive_sync_class text;
        ALTER TABLE hafd.indexes_constraints
            ADD CONSTRAINT indexes_constraints_massive_sync_class_check CHECK ( massive_sync_class IN ('keep', 'defer') );
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = 'hafd' AND table_name = 'contexts' AND column_name = 'early_block_processing'
    ) THEN
        ALTER TABLE hafd.contexts ADD COLUMN early_block_processing BOOL NOT NULL DEFAULT FALSE;
    END IF;

    -- Note: there is intentionally no migration for the rc_cost column of hafd.transactions
    -- and hafd.transactions_reversible - the values cannot be backfilled without a replay,
    -- so the schema hash mismatch reported by verify_table_schema forces one.
END \$\$;
"

verify_table_schema

check_commit_difference

generate_final_update_script

check_tables_dont_reference_haf_types

check_tables_dont_reference_haf_domains

migrate_account_operations_uq1

update_extension
