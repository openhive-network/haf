# The image the `haf-system` suite of the `full` slot runs in (its `image:` in
# .aidev/project.yaml): the testnet HAF image, whose hived the system tests drive,
# with the Python environment of tests/integration/haf-local-tools installed
# beforehand. AIDEV runs a suite container with no network, so nothing can be
# installed when the suite runs, as CI's run_haf_system_tests.sh does.
#
# Base: hive/haf/testnet:v-l2-6f476cfd — built from develop 46558ea2e, the
# source of the mainnet base in Dockerfile (BUILD_HIVE_TESTNET=ON). Re-pin it with
# that one.
#
# The venv holds haf-local-tools' locked dependencies, not haf_local_tools
# itself: the suite imports that from the candidate's tree (PYTHONPATH). The lock
# file it was built from is kept beside it, so a candidate whose lock differs is
# reported as needing a new image (.aidev/haf-system.sh). Importing test_tools
# once here lets wax create the links to its Cython modules it makes on first
# import, which the suite's uid could not write. Build with
# `.aidev/runtime/build.sh --system`; the context is haf-local-tools'
# pyproject.toml and poetry.lock.
FROM registry.gitlab.syncad.com/hive/haf/testnet@sha256:841961babefe6a255515b706d165fa6d6d60cff13c32c57c78aa759c5e6afceb

USER root
COPY pyproject.toml poetry.lock /tmp/haf-local-tools/
RUN python3.14 -m venv /opt/poetry \
    && /opt/poetry/bin/pip install --no-cache-dir poetry==2.1.3 \
    && python3.14 -m venv /opt/haf-system-venv \
    && cd /tmp/haf-local-tools \
    && VIRTUAL_ENV=/opt/haf-system-venv PATH="/opt/haf-system-venv/bin:$PATH" \
        /opt/poetry/bin/poetry install --no-root --no-interaction \
    && /opt/haf-system-venv/bin/python -c "import test_tools" \
    && cp poetry.lock /opt/haf-system-venv/haf-local-tools.poetry.lock \
    && rm -rf /opt/poetry /tmp/haf-local-tools /root/.cache

USER hived
ENTRYPOINT []
CMD ["bash"]
